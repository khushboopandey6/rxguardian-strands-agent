# AWS Configuration for Amazon Bedrock
# If left blank, RxGuardian will run in local simulated Bedrock mode for testing.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model Configuration
# Options: anthropic.claude-3-5-sonnet-20241022-v2:0, anthropic.claude-3-haiku-20240307-v1:0, amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Application Settings
PORT=8000
HOST=0.0.0.0
DEBUG=true
